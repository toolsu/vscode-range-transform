# Everything the extension needs at runtime is bundled into dist/extension.js by
# esbuild, including the .d.ts text the Advanced command writes to its scratch
# directory. Nothing under src/ or node_modules/ ships.

.github/**
.vscode/**
.vscode-test/**
docs/**
site/**
node_modules/**
out/**
scripts/**
src/**

.editorconfig
.gitattributes
.gitignore
.prettierrc.mjs
esbuild.js
eslint.config.mjs
icon.svg

**/.vscode-test.*
**/*.lock
**/*.map
**/*.ts
**/*.vsix
**/package-lock.json
**/pnpm-lock.yaml
**/tsconfig*.json
**/yarn.lock
