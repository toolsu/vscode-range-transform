{
  "name": "range-transform",
  "publisher": "tomchen",
  "displayName": "Range & Transform",
  "description": "Insert sequence from range (2:9, Mon:Fri:2); transform multi-selections with JS (n*3, letter(n))",
  "version": "1.0.0",
  "icon": "icon.png",
  "packageManager": "bun@1.2.2",
  "engines": {
    "vscode": "^1.75.0"
  },
  "extensionKind": [
    [
      "ui",
      "workspace"
    ]
  ],
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "range",
    "sequence",
    "increment",
    "transform",
    "conversion",
    "selection",
    "number",
    "numeral",
    "chinese",
    "french",
    "date",
    "letter",
    "insert",
    "multi-selection"
  ],
  "bugs": {
    "url": "https://github.com/tomchen/vscode-range-transform/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tomchen/vscode-range-transform"
  },
  "license": "MIT",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "range-transform.range",
        "title": "R&T: Insert Sequence from Range"
      },
      {
        "command": "range-transform.transform",
        "title": "R&T: Transform Multi-Selections (Simple)"
      },
      {
        "command": "range-transform.transform-advanced",
        "title": "R&T: Transform Multi-Selections (Advanced)"
      }
    ]
  },
  "activationEvents": [],
  "scripts": {
    "vscode:prepublish": "bun run compile:prod",
    "compile": "bun run check-types && bun run lint && node esbuild.js && bun run gentypes",
    "compile:prod": "bun run check-types && bun run lint && node esbuild.js --production && bun run gentypes",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "checkall": "bun run check-types && bun run lint && bun run format",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vscode-test",
    "test:clean": "rimraf .vscode-test out && bun run test",
    "vsix": "vsce package",
    "genconvnumtypes": "bun scripts/genConvnumTypes.ts",
    "gentransformtypes": "bun scripts/genTransformTypes.ts",
    "gentypes": "bun run genconvnumtypes && bun run gentransformtypes",
    "postinstall": "bun run gentypes"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/node": "20.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.5",
    "eslint": "^9.30.0",
    "module-alias": "^2.2.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "convnum": "^0.2.7"
  }
}
