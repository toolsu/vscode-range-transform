// Deploys the built site (site/out, from `bun run build:pages`) as a Worker with static
// assets, served at https://toolsu.com/range-transform/. The files sit under
// out/range-transform/, so the request path maps straight onto them.
{
  "name": "range-transform",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "toolsu.com/range-transform*", "zone_name": "toolsu.com" }],
  "workers_dev": false,
  "preview_urls": false
}
